# SmartDialer settings (all optional; defaults shown)
# STRICT = deterministic zero-abandon guarantee; BOUNDED_RISK = probabilistic over-dial within epsilon
SMARTDIALER_SAFETY_MODE=STRICT
# Max per-cycle probability that a pooled call is answered with no agent free (BOUNDED_RISK only)
SMARTDIALER_ABANDON_EPSILON=0.01
# Global cap on calls in flight across all campaigns
SMARTDIALER_MAX_OUTSTANDING_CALLS=5000
# SQLite file used by the API (deleted and recreated on each API start); ":memory:" also works
SMARTDIALER_DB_PATH=data/smartdialer.db
SMARTDIALER_SEED=42
